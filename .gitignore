# Vendor binaries and copyrighted documentation — not project source
user-files/WING-Edit.exe
user-files/User-Manual_WING-series_*.pdf

# Third-party skill archive, not ours to redistribute
user-files/mastering-engineer-*.tar.gz

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
junit.xml

# JUnit XML written with --junitxml (D-47/D-54 -- the summary line is
# unreliable, so tasks read the tally from here instead)
dist-reports/

# PyInstaller build output; the spec in packaging/ is the source
*.spec.bak
# ...except this one, which packaging/make-debug-spec.py generates from
# wing-ui.spec and whose own header says it stays UNTRACKED (D-46).
packaging/wing-ui-debug.spec

# Local secrets — the Anthropic key for the classifier fallback lives here
.env

# Local secrets — provider.yaml may carry a pasted API key (docs/user-manual/04)
provider.yaml

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# OS
Thumbs.db
.DS_Store

# transient pytest output dumps, at the repo root only
/*verbose*.txt
/pytest_out.log
/baseline.txt
/*.junit.xml

screenshots/
shots-test/
dist-shots/

# ...except a set deliberately attached to a PR. Those are review
# evidence -- the only thing that shows a page actually rendered from
# the exe -- so they have to survive on the branch. The pattern above
# is unanchored and would otherwise swallow this directory too.
!docs/screenshots/
