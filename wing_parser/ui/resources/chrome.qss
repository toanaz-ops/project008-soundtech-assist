/* WING Parser house stylesheet, part 2 -- the shell chrome: sidebar,
   splitters, scrollbars, dock, menus. Concatenated with theme.qss by
   wing_parser.ui.theme.qss before substitution; same token rules apply.
*/

/* -- sidebar: the transport lamp rotated ------------------------------- */

QListWidget#sidebar {
    background: $panel;
    border: none;
    border-right: 1px solid $border;
}

QListWidget#sidebar::item {
    min-height: ${METRICS_touch_target}px;
    padding-left: ${METRICS_gap}px;
    /* The dark lamp track: reserved so the lit row never shifts text. */
    border-left: 3px solid transparent;
    color: $dim;
}

QListWidget#sidebar::item:hover {
    background: $raise_;
}

QListWidget#sidebar::item:selected {
    background: $raise_;
    border-left: 3px solid $accent;
    color: $text;
}

/* -- splitters and scrollbars ------------------------------------------ */

QSplitter::handle {
    background: $background;
}

QSplitter::handle:horizontal {
    width: ${METRICS_gap}px;
}

QSplitter::handle:vertical {
    height: ${METRICS_gap}px;
}

QScrollBar:vertical {
    background: $panel;
    width: ${METRICS_gap}px;
}

QScrollBar:horizontal {
    background: $panel;
    height: ${METRICS_gap}px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: $border;
    border-radius: 2px;
    min-height: ${METRICS_gap}px;
    min-width: ${METRICS_gap}px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: $faded;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* -- dock, menus and dialogs ------------------------------------------- */

QMenuBar {
    background: $panel;
    border-bottom: 1px solid $border;
    padding-left: ${METRICS_unit}px;
}

QMenuBar::item {
    background: transparent;
    padding: ${METRICS_unit}px ${METRICS_gap}px;
}

QMenuBar::item:selected {
    background: $raise_;
}

QMenu {
    background: $raise_;
    color: $text;
    border: 1px solid $border;
}

QMenu::item {
    padding: ${METRICS_unit}px ${METRICS_margin}px;
}

QMenu::item:selected {
    background: $accent;
    color: $shade;
}

QMenu::separator {
    height: 1px;
    background: $border;
}

QDockWidget::title {
    background: $panel;
    border-bottom: 1px solid $border;
    padding: ${METRICS_unit}px ${METRICS_gap}px;
}
